+public final class ScopegramAntiDeleteRegistry: @unchecked Sendable {
+    public static let shared = ScopegramAntiDeleteRegistry()
+    private let lock = NSLock()
+    private var deletedMessageIds: Set<MessageId> = []
+    private var deletedGlobalIds: Set<Int32> = []
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: "scopegram.deletedMessageIdsJson") {
+            if let decoded = try? JSONDecoder().decode([MessageId].self, from: data) {
+                deletedMessageIds = Set(decoded)
+            }
+        }
+        if let stored = UserDefaults.standard.array(forKey: "scopegram.deletedGlobalIds") as? [NSNumber] {
+            deletedGlobalIds = Set(stored.map { $0.int32Value })
+        }
+    }
+
+    public func record(messageIds: [MessageId]) {
+        lock.lock()
+        defer {
+            save()
+            lock.unlock()
+        }
+        for mId in messageIds {
+            deletedMessageIds.insert(mId)
+        }
+    }
+
+    public func record(globalIds: [Int32]) {
+        lock.lock()
+        defer {
+            save()
+            lock.unlock()
+        }
+        for gId in globalIds {
+            deletedGlobalIds.insert(gId)
+        }
+    }
+
+    public func isDeleted(peerId: PeerId, messageId: MessageId) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        if deletedMessageIds.contains(messageId) {
+            return true
+        }
+        if deletedGlobalIds.contains(messageId.id) {
+            return true
+        }
+        return false
+    }
+
+    private func save() {
+        let maxCount = 2000
+        let toSave = Array(deletedMessageIds.suffix(maxCount))
+        if let data = try? JSONEncoder().encode(toSave) {
+            UserDefaults.standard.set(data, forKey: "scopegram.deletedMessageIdsJson")
+        }
+        let toSaveGlobals = Array(deletedGlobalIds.suffix(maxCount)).map { NSNumber(value: $0) }
+        UserDefaults.standard.set(toSaveGlobals, forKey: "scopegram.deletedGlobalIds")
+    }
+}
+
+public struct ScopegramEditHistoryEntry: Codable, Sendable {
+    public let text: String
+    public let date: Int32
+    public init(text: String, date: Int32) {
+        self.text = text
+        self.date = date
+    }
+}
+
+public final class ScopegramEditHistoryRegistry: @unchecked Sendable {
+    public static let shared = ScopegramEditHistoryRegistry()
+    private let lock = NSLock()
+    private var history: [MessageId: [ScopegramEditHistoryEntry]] = [:]
+
+    private init() {
+        if let data = UserDefaults.standard.data(forKey: "scopegram.editHistoryJson") {
+            if let decoded = try? JSONDecoder().decode([MessageId: [ScopegramEditHistoryEntry]].self, from: data) {
+                history = decoded
+            }
+        }
+    }
+
+    public func record(messageId: MessageId, text: String, date: Int32) {
+        guard !text.isEmpty else { return }
+        lock.lock()
+        defer {
+            save()
+            lock.unlock()
+        }
+        var list = history[messageId] ?? []
+        if list.last?.text != text {
+            list.append(ScopegramEditHistoryEntry(text: text, date: date))
+            history[messageId] = list
+        }
+    }
+
+    public func getHistory(messageId: MessageId) -> [ScopegramEditHistoryEntry]? {
+        lock.lock()
+        defer { lock.unlock() }
+        return history[messageId]
+    }
+
+    public func hasHistory(messageId: MessageId) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        return !(history[messageId]?.isEmpty ?? true)
+    }
+
+    private func save() {
+        let maxEntries = 500
+        var trimmed = history
+        if trimmed.count > maxEntries {
+            let keysToRemove = trimmed.keys.prefix(trimmed.count - maxEntries)
+            for k in keysToRemove {
+                trimmed.removeValue(forKey: k)
+            }
+        }
+        if let data = try? JSONEncoder().encode(trimmed) {
+            UserDefaults.standard.set(data, forKey: "scopegram.editHistoryJson")
+        }
+    }
+}
